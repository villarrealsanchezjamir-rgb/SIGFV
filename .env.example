# Copie este archivo como .env y complete los valores. NUNCA suba .env a un repositorio.
PORT=3000
NODE_ENV=development
JWT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria-123456

# Supabase -> Project Settings -> API
SUPABASE_URL=https://SU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=SU_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SU_SERVICE_ROLE_KEY

# Supabase -> Project Settings -> Database -> Connection string (Pooler)
# Formato: postgresql://postgres.PROYECTO:PASSWORD@REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.PROYECTO:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# URL pública HTTPS del backend. Se graba en la APK al compilar con:
#   npm run mobile:apk:public -- https://tu-servicio
# Para usar la APK desde cualquier red debe ser HTTPS, no localhost ni una IP privada.
# En Render/Fly/VPS este valor se configura en el panel o en .env.production, no aquí.
PUBLIC_API_URL=https://sigfv.example.com
