<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 (API 35) fuerza edge-to-edge. La app móvil usa su propio
         diseño con barras del sistema; se desactiva la superposición para
         que la barra superior y el teclado no tapen contenido. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/sigfv_bg</item>
        <item name="android:statusBarColor">@color/sigfv_carbon</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/sigfv_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/sigfv_carbon</item>
        <item name="android:navigationBarColor">@color/sigfv_carbon</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
